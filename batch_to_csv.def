Bootstrap: docker
From: pytorch/pytorch:2.2.0-cuda12.1-cudnn8-runtime

%post
    apt-get update && apt-get install -y ffmpeg && rm -rf /var/lib/apt/lists/*
    pip install --no-cache-dir openai-whisper>=20231117 transformers>=4.36.0 numpy>=1.24.0

%runscript
    python /workspace/batch_to_csv.py "$@"
